{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "bun install --frozen-lockfile && cd dashboard && bun install --frozen-lockfile",
  "buildCommand": "cd dashboard && bun run build",
  "outputDirectory": "dashboard/dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sw\\.js$|manifest\\.webmanifest$).*)",
      "destination": "/index.html"
    }
  ]
}
